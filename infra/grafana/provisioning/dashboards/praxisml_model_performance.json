{
    "__requires": [
        {
            "type": "grafana",
            "id": "grafana",
            "name": "Grafana",
            "version": "10.0.0"
        },
        {
            "type": "datasource",
            "id": "prometheus",
            "name": "Prometheus",
            "version": "1.0.0"
        },
        {
            "type": "panel",
            "id": "timeseries",
            "name": "Time series",
            "version": ""
        },
        {
            "type": "panel",
            "id": "stat",
            "name": "Stat",
            "version": ""
        }
    ],
    "annotations": {
        "list": []
    },
    "description": "Model-level performance metrics — latency, throughput, errors, drift, and health",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [],
    "panels": [
        {
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 10
                    },
                    "unit": "ms"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "id": 1,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "targets": [
                {
                    "expr": "praxisml_inference_latency_ms{model_id=~\"$model_id\"}",
                    "legendFormat": "{{model_id}} - quantile {{quantile}}",
                    "refId": "A"
                }
            ],
            "title": "Latencia p50 / p95 / p99",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 10
                    },
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "id": 2,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "targets": [
                {
                    "expr": "praxisml_drift_score{model_id=~\"$model_id\"}",
                    "legendFormat": "{{model_id}} - {{metric}}",
                    "refId": "A"
                }
            ],
            "title": "Drift Score",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 50
                            },
                            {
                                "color": "red",
                                "value": 100
                            }
                        ]
                    },
                    "unit": "reqps"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 4,
                "w": 8,
                "x": 0,
                "y": 8
            },
            "id": 3,
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "orientation": "auto",
                "colorMode": "background"
            },
            "targets": [
                {
                    "expr": "sum(rate(praxisml_predictions_total{model_id=~\"$model_id\", tenant_id=~\"$tenant_id\"}[5m]))",
                    "legendFormat": "Throughput",
                    "refId": "A"
                }
            ],
            "title": "Throughput (requests/s)",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 0.01
                            }
                        ]
                    },
                    "unit": "percentunit"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 4,
                "w": 8,
                "x": 8,
                "y": 8
            },
            "id": 4,
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "orientation": "auto",
                "colorMode": "background"
            },
            "targets": [
                {
                    "expr": "sum(rate(praxisml_errors_total{model_id=~\"$model_id\", tenant_id=~\"$tenant_id\"}[5m])) / sum(rate(praxisml_predictions_total{model_id=~\"$model_id\", tenant_id=~\"$tenant_id\"}[5m]))",
                    "legendFormat": "Error rate",
                    "refId": "A"
                }
            ],
            "title": "Error Rate",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 0.8
                            },
                            {
                                "color": "red",
                                "value": 0.5
                            }
                        ]
                    },
                    "unit": "percentunit"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 4,
                "w": 8,
                "x": 16,
                "y": 8
            },
            "id": 5,
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "orientation": "auto",
                "colorMode": "background"
            },
            "targets": [
                {
                    "expr": "up{job=\"praxisml_api\"}",
                    "legendFormat": "API health",
                    "refId": "A"
                }
            ],
            "title": "Model Health (API Up)",
            "type": "stat"
        }
    ],
    "refresh": "10s",
    "schemaVersion": 38,
    "style": "dark",
    "tags": [
        "praxisml",
        "models",
        "observability"
    ],
    "templating": {
        "list": [
            {
                "current": {
                    "selected": true,
                    "text": "All",
                    "value": "$__all"
                },
                "datasource": {
                    "type": "prometheus",
                    "uid": "Prometheus"
                },
                "definition": "label_values(praxisml_inference_latency_ms, model_id)",
                "hide": 0,
                "includeAll": true,
                "multi": true,
                "name": "model_id",
                "options": [],
                "query": "label_values(praxisml_inference_latency_ms, model_id)",
                "refresh": 1,
                "regex": "",
                "skipUrlSync": false,
                "sort": 1,
                "type": "query"
            },
            {
                "current": {
                    "selected": true,
                    "text": "All",
                    "value": "$__all"
                },
                "datasource": {
                    "type": "prometheus",
                    "uid": "Prometheus"
                },
                "definition": "label_values(praxisml_predictions_total, tenant_id)",
                "hide": 0,
                "includeAll": true,
                "multi": true,
                "name": "tenant_id",
                "options": [],
                "query": "label_values(praxisml_predictions_total, tenant_id)",
                "refresh": 1,
                "regex": "",
                "skipUrlSync": false,
                "sort": 1,
                "type": "query"
            }
        ]
    },
    "time": {
        "from": "now-30m",
        "to": "now"
    },
    "timepicker": {},
    "timezone": "browser",
    "title": "Model Performance",
    "uid": "praxisml-model-performance",
    "version": 1
}
