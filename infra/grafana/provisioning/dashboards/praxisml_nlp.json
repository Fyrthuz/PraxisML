    "graphTooltip": 1,
    "id": null,
    "links": [],
    "panels": [
        {
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 10
                    },
                    "unit": "s"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "id": 1,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum by(le, algorithm) (rate(praxisml_training_duration_seconds_bucket{domain=\"nlp\", tenant_id=~\"$tenant_id\"}[5m])))",
                    "legendFormat": "p95 {{algorithm}}",
                    "refId": "A"
                }
            ],
            "title": "Duración Entrenamiento NLP (p95)",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
